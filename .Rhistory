cat("CV RMSE:", round(cv_rmse), "\nCV MAE: ", round(cv_mae), "\n")
# Better plot: actual vs. cross-validated predicted
ggplot(cv, aes(x = cvpred, y = MEDHHINC)) +
geom_point(alpha = 0.3, size = 1.5, color = "steelblue") +
geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
geom_smooth(method = "lm", se = FALSE, color = "black", linewidth = 0.8) +
labs(
title = "Cross-validated predictions vs. actual median household income",
subtitle = paste0("5-fold CV | RMSE = ", round(cv_rmse)),
x = "Cross-validated predicted MEDHHINC",
y = "Actual MEDHHINC"
) +
theme_minimal()
# Better plot: actual vs. cross-validated predicted
ggplot(cv, aes(x = cvpred, y = MEDHHINC)) +
geom_point(alpha = 0.4, color = "steelblue") +
geom_abline(slope = 1, intercept = 0, color = "red", linetype = "dashed") +
facet_wrap(~ fold) +
labs(x = "Cross-validated predicted MEDHHINC", y = "Actual MEDHHINC") +
theme_minimal()
