cor(mydata$X, mydata$Y, method="pearson")       #method can be pearson or spearman
cor(mydata$X, mydata$Y, method="spearman")
cor(mydata$RankX, mydata$RankY, method="pearson")
cor(mydata)
cor.test(mydata$X, mydata$Y, method=("pearson"))
