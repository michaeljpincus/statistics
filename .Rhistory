# 1. Create sample data
x <- c(1, 2, 4, 8, 16)
y <- c(1, 2, 3, 4, 5)
# 2. Fit the linear model (y continuous dependent, x independent)
model <- lm(y ~ x)
# 3. Extract beta 1 (the slope coefficient)
beta_1 <- coef(model)["x"]
# Print the result
print(beta_1)
